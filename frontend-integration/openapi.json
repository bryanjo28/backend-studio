  "components": {
    "schemas": {
      "Body_upload_api_projects__slug__assets_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "category": {
            "type": "string",
            "enum": [
              "characters",
              "backgrounds",
              "props",
              "voiceover",
              "script"
            ],
            "title": "Category",
            "default": "props"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_projects__slug__assets_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewProject": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "default": "Untitled"
          },
          "aspect": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16"
            ],
            "title": "Aspect",
            "default": "16:9"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "720p",
              "1080p",
              "1440p",
              "2160p"
            ],
            "title": "Resolution",
            "default": "1080p"
          },
          "fps": {
            "type": "integer",
            "enum": [
              24,
              30
            ],
            "title": "Fps",
            "default": 24
          },
          "style": {
            "type": "string",
            "enum": [
              "emerald",
              "ember",
              "arctic",
              "sakura",
              "retro"
            ],
            "title": "Style",
            "default": "emerald"
          },
          "captions": {
            "type": "boolean",
            "title": "Captions",
            "default": false
          },
          "renderer": {
            "type": "string",
            "enum": [
              "growkaz",
              "remotion"
            ],
            "title": "Renderer",
            "default": "growkaz"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Slug"
          },
          "template": {
            "type": "string",
            "enum": [
              "empty",
              "demo"
            ],
            "title": "Template",
            "default": "empty"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slug"
        ],
        "title": "NewProject"
      },
      "RenderRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sheet",
              "preview",
              "render",
              "mix"
            ],
            "title": "Kind",
            "default": "sheet"
          },
          "start": {
            "type": "number",
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Start",
            "default": 0
          },
          "end": {
            "type": "number",
            "maximum": 86400.0,
            "exclusiveMinimum": 0.0,
            "title": "End",
            "default": 10
          },
          "scale": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.1,
            "title": "Scale",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RenderRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
